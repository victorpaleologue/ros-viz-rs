<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen so the egui connection bar sits at the real top edge of the
         surface. Bevy puts the window in BorderlessFullscreen, which draws
         edge-to-edge *under* the system status bar; without hiding that bar the
         one-row connection panel rendered entirely behind it and was invisible
         and untappable. NoActionBar because GameActivity renders everything
         itself (and AppCompat requires an AppCompat parent theme). -->
    <style name="Theme.RosVizRs" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
