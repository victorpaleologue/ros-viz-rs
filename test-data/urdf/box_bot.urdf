<?xml version="1.0"?>
<robot name="box_bot">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.2 0.2" />
      </geometry>
    </visual>
  </link>
  <link name="tip_link" />
  <joint name="shoulder" type="revolute">
    <parent link="base_link" />
    <child link="tip_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="1" velocity="1" />
  </joint>
</robot>
